@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Invalid Token";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Invalid Token - Travelex</title>
    <link rel="stylesheet" href="/css/site.css" />
    <link rel="stylesheet" type="text/css" href="/css/print.css" />

    <style>
        body {
            font-size: 1rem;
            font-weight: 400;
            line-height: 1.5;
            color: #212529;
            text-align: left;
            min-height: 97vh;
            max-width: 100vw;
            color: rgb(12, 22, 44);
            background: url(data:image/png;base64,) 0% 0% / 80% 100% no-repeat rgb(229, 229, 229);
            ;
            background-repeat: no-repeat;
        }

        h1 {
            color: maroon;
            margin-left: 40px;
        }

        a, a:hover {
            color: #068dd0;
            text-decoration: none;
        }

        .bJCmFu {
            color: rgb(215, 30, 27);
            font-size: 25px;
            font-weight: 700;
        }

        .eSbheu {
            color: rgb(170, 172, 174);
            font-size: 25px;
            font-weight: 700;
        }

        .formTitle {
            color: rgb(12, 22, 44);
            font-weight: bold;
            font-size: 26px;
            text-align: center;
        }

        .subTitle {
            color: rgb(73, 77, 85);
            font-size: 14px;
            text-align: center;
            padding-bottom: 30px;
        }

        .cVmQYF {
            background: rgb(215, 30, 27);
            box-shadow: rgba(0, 0, 0, 0.12) 0px 6px 12px;
            border-radius: 3px;
            height: 40px;
            border: none;
            color: rgb(255, 255, 255);
            font-weight: 700;
            font-size: 14px;
        }

        .kfRyXm {
            font-size: 12px;
            color: red;
        }

        [type=submit]:not(:disabled), button:not(:disabled) {
            cursor: pointer;
        }

        .centered {
            position: fixed;
            top: 35%;
            left: 40%;
            margin-top: -50px;
            margin-left: -100px;
            border-style: solid;
            border-color: black;
            border-width: 1px;
            padding-left: 3%;
            padding-right: 3%;
            padding-top: 2%;
            padding-bottom: 2%;
            background-color: white;
        }

        button {
            width: 100%;
        }

        .bord {
            width: 90%;
            padding: 4%;
            border-radius: 5%;
            border-width: 1.7px !important;
        }

        .warning {
            font-size: 1.0em;
            font-weight: 700;
            color: sandybrown;
        }

        .success-alert {
            font-size: 1.2em;
            color: green;
        }

        .error-alert {
            font-size: 1.2em;
            color: red;
        }

        .text-center {
            text-align: center;
            margin: auto;
            width: 100%;
            display: block;
        }
    </style>
</head>

<body>
    <div>
        <div>
            <div class="sc-AxhCb eSwYtm"><a href="https://pharmmall.azurewebsites.net"><span class="sc-AxirZ bJCmFu">Health</span><span class="sc-AxiKw eSbheu">banc</span></a></div>
            <div>
                <p class="warning">
                    A security token atached to your Verification Mail link has either expired or is invalid. Please input email address attached to the Health
                    Banc account to get another mail with a valid token.
                </p>
            </div>

            @if (ViewBag.Success != null)
            {
                <div class="text-center">
                    <span class="success-alert">** @ViewBag.Success</span>
                </div>
            }
            @if (ViewBag.Error != null)
            {
                <div class="text-center">
                    <span class="error-alert">** @ViewBag.Error</span>
                </div>
            }

            <div class="work sc-AxhUy fxWvvr row align-items-center mx-0 px-2">
                <div class="centered col mx-md-auto formContainer container">
                    <div class="my-4">
                        <div class="formTitle">Resend Verification Email</div>
                        <div class="subTitle">Enter your email address to get a mail with a valid token</div>
                    </div>
                    <form method="get" asp-action="ResendConfirmationLink" asp-controller="Identity">
                        <div class="sc-fzoyTs jZUSDr"><div><div for="email" class="sc-fzoNJl loPePV">Email Address</div></div><div class="input-div"><div class="d-flex flex-row"><input class="sc-fzoXWK hnKkAN formInput bord" required name="email" type="email" placeholder="Enter your email here" value="" style="background-color: rgb(255, 255, 255);"></div><div class="error-container"><div class="sc-fznxKY kfRyXm error p-0 m-0">*Required</div></div></div></div>

                        <button type="submit" class="sc-AxgMl cVmQYF">Submit</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

</body>

</html>


