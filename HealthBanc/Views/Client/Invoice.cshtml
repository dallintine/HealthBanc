@using System.Globalization
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

@model InvoicePDFTemplateDTO

@{
   Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="content-type" content="text/html; charset=utf-8" />
    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <title>HealthBanc</title>
    <style>
        @@media only screen {
            #table {
                margin: 0 auto !important;
                margin-top: 2% !important;
                padding: 2% 3%;
                width: 70% !important;
            }

            #terms {
                margin: 0 auto !important;
                padding: 2% 3%;
                width: 70% !important;
            }

            tr {
                font-size: 18px !important;
            }
        }

        @@media only screen and (max-width: 1023px) {
            #table {
                margin: 0 auto !important;
                margin-top: 2% !important;
                padding: 2% 3%;
                width: 70% !important;
            }

            #fist_bump {
                background-image: url("https://pharmhallstracct.blob.core.windows.net/email/gift.PNG");
                height: 150px;
                background-position: center;
                background-size: contain;
                background-repeat: no-repeat;
                width: 100%;
            }

            #terms {
                margin: 0 auto !important;
                padding: 2% 3%;
                width: 50% !important;
            }
        }

        @@media only screen and (max-width: 767px) {
            #table {
                margin: 0 auto !important;
                margin-top: 2% !important;
                padding: 2% 3%;
                width: 70% !important;
            }

            #terms {
                margin: 0 auto !important;
                padding: 2% 3%;
                width: 70% !important;
            }

            tr {
                font-size: 16px !important;
            }
        }

        @@media only screen and (max-width: 481px) {
            #table {
                margin: 0 auto !important;
                margin-top: 2% !important;
                padding: 2% 3%;
                width: 95% !important;
            }

            #fist_bump {
                background-image: url("https://pharmhallstracct.blob.core.windows.net/email/gift.PNG");
                height: 100px !important;
                background-position: center;
                background-size: contain !important;
                background-repeat: no-repeat;
                width: 100%;
            }

            #terms {
                margin: 0 auto !important;
                padding: 2% 3%;
                width: 95% !important;
            }
        }
    </style>
</head>
<body style="
      margin: 0;
      border: 0;
      font-family: Helvetica, 'Helvetica Neue', arial, verdana, sans-serif;
    ">
    <table id="table"
           style="border-radius: 10px; border: 2px solid #ecf1fa;"
           cellpadding="0"
           cellspacing="0">
        <tr style="text-align: left;width: 100%;">
            <td style="padding: 2%">
                <img src="https://pharmhallstracct.blob.core.windows.net/logfolder/4c3255b2-03fd-49df-a37d-693bcd5f7882_healthlog.png" alt="Healthbanc logo" />
            </td>
        </tr>
        <tr style="text-align: center; background-color: #ecf1fa;width: 100%">
            <td style="padding: 2%;width: 100%">
                <span style="
                width: 100%;
              font-size: 20px;
              font-weight: bold;
              font-stretch: normal;
              font-style: normal;
              line-height: normal;
              letter-spacing: 0.25px;
              color: black;
            ">Healthbanc</span>
            </td>
        </tr>
        <tr style="text-align: justify;width: 100%">
            <td style="text-align: justify; font-weight: bolder;width: 100%">
                <h3>Healthbanc: Purchase Receipt</h3>
            </td>
        </tr>
        <tr style="text-align: center;width: 100%">
            <td style="text-align: center;font-size: 13px;width: 100%">
                <span>  Hi @Model.Name</span>
                <p>Great news! Your recent purchase on Healthbanc was successful. Here are the details:</p>
            </td>
        </tr>
        <tr id="welcome_header" style="text-align: justify;width: 100%">
            <td >
                <h4>Order Summary</h4>
            </td>
        </tr>
        <tr style="width: 100%;margin-top: 3em;margin-bottom: 2em; clear: both;">
            <td style="width: 55%;margin: 0% 1%;font-size: 14px;text-align: center">&nbsp;Product Name&nbsp;</td>
            <td style="width: 55%;margin: 0% 1%;font-size: 14px;text-align: center">&nbsp;Vendor Name&nbsp;</td>
            <td style="width: 5%;margin: 0% 1%;font-size: 14px;text-align: center">&nbsp;Quantity&nbsp;</td>
            <td style="width: 32%;margin: 0% 1%;font-size: 14px;text-align:center">&nbsp;Price</td>
        </tr>
        @{
            foreach (var item in @Model.InvoiceItems)
            {
                    <tr style="width: 100%;margin-top: 0.5em;clear: both;">
                    <td style="width: 55%;margin: 0% 1%;font-size: 14px">&nbsp;@item.ProductName&nbsp;</td>
                    <td style="width: 55%;margin: 0% 1%;font-size: 14px">&nbsp;@item.VendorName&nbsp;</td>
                    <td style="width: 5%;margin: 0% 1%;font-size: 14px">&nbsp;@item.Quantity&nbsp;</td>
                    <td style="width: 32%;margin: 0% 1%;font-size: 14px;text-align:right">&nbsp;@string.Format(new CultureInfo("en-NG", false), "{0:c0}", item.Price)</td>
                    </tr>
                <tr>&nbsp;</tr>
            }
        }
          <tr style="width: 100%;margin-top: 3em; ">
            <td style="width: 55%;margin: 0% 1%;font-size: 14px">Transaction Fee</td>
            <td style="width: 5%;margin: 0% 1%;"></td>
            <td style="width: 5%;margin: 0% 1%;"></td>
            <td style="width: 32%;margin: 0% 1%;font-size: 14px;text-align:right">&nbsp; &nbsp; @string.Format(new CultureInfo("en-NG", false), "{0:c0}", Model.TransactionCharge)</td>
         </tr><tr>&nbsp;</tr>
        
         <tr style="width: 100%;margin-top: 3em; ">
            <td style="width: 35%;margin: 0% 1%;font-size: 16px">SubTotal</td>
            <td style="width: 2%;margin: 0% 1%;"></td>
            <td style="width: 2%;margin: 0% 1%;"></td>
            <td style="width: 60%;margin: 0% 1%;font-size: 16px;text-align:right">&nbsp; &nbsp; @string.Format(new CultureInfo("en-NG", false), "{0:c0}", Model.SubTotal)</td>
         </tr>
          <tr style="width: 100%;margin-top: 3em; ">
            <td style="width: 35%;margin: 0% 1%;font-size: 16px">Total</td>
            <td style="width: 2%;margin: 0% 1%;"></td>
            <td style="width: 2%;margin: 0% 1%;"></td>
            <td style="width: 60%;margin: 0% 1%;font-size: 16px;text-align:right">&nbsp; &nbsp; @string.Format(new CultureInfo("en-NG", false), "{0:c0}", Model.Total)</td>
         </tr>
         <tr>
             <td>
                <p style="font-size: 13px" >Transaction Id : @Model.InvoiceItems.FirstOrDefault().TransactionId</p>
                <p style="font-size: 13px">Transaction Date : @Model.InvoiceItems.FirstOrDefault().TransactionDate</p>
             </td>
         </tr>
                  
        <tr>
            <td style="font-size: 13px;text-align: center;">
                <p>Got questions, feedback, or just want to chat? Shoot us an email at healthbancng@sterling.ng or give us a call at +234-905-386-5787.</p>
                <p style="color: black">
                    Thank you for choosing Healthbanc. Cheers to a healthier, happier you!
                </p>
                <p style="color: black">
                    Best Regards,<br/>
                    The Healthbanc Team
                </p>
            </td>
        </tr>
        <tr  style="text-align: center; background-color: #ecf1fa">
            <td >
                <p>© 2023 Healthbanc. All Rights Reserved</p>
            </td>
        </tr>
    </table>
</body>
</html>

